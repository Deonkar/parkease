{
  "name": "parkease",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @parkease/db generate",
    "db:migrate": "pnpm --filter @parkease/db migrate",
    "db:seed": "pnpm --filter @parkease/db seed",
    "db:seed:bootstrap": "pnpm --filter @parkease/db seed:bootstrap",
    "db:seed:dev": "pnpm --filter @parkease/db seed:dev",
    "db:seed:perf": "pnpm --filter @parkease/db seed:perf",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check:node": "bash scripts/check-node-version.sh",
    "test:root": "vitest run --config vitest.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@parkease/config": "workspace:*",
    "eslint": "9.17.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>react": "19.2.3",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "@grpc/grpc-js": "1.14.5",
      "tar-fs@2": "2.1.5",
      "postcss@<8.5.29": "8.5.29",
      "next>sharp": "0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}

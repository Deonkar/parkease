{
  "name": "parkease",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @parkease/db generate",
    "db:migrate": "pnpm --filter @parkease/db migrate",
    "db:seed": "pnpm --filter @parkease/db seed",
    "db:seed:bootstrap": "pnpm --filter @parkease/db seed:bootstrap",
    "db:seed:dev": "pnpm --filter @parkease/db seed:dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check:node": "bash scripts/check-node-version.sh",
    "test:root": "vitest run --config vitest.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@parkease/config": "workspace:*",
    "eslint": "9.17.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>react": "19.2.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}

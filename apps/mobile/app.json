{
  "expo": {
    "name": "ParkEase",
    "slug": "parkease",
    "scheme": "parkease",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.parkease.app",
      "supportsTablet": false
    },
    "android": {
      "package": "in.parkease.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-status-bar"],
    "web": {
      "bundler": "metro"
    }
  }
}

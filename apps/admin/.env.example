# Production API origin. Leave empty in dev: Vite proxies /api to http://localhost:3000.
VITE_API_URL=
# Firebase web app config (phone OTP sign-in). Public by design; restricted by authorised domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Dev without API or Firebase: `pnpm --filter @parkease/admin dev:fixtures` (port 5174).

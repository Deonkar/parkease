{
  "name": "@parkease/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@parkease/contracts": "workspace:*",
    "@parkease/db": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.4.0",
    "pg-boss": "10.1.5",
    "pino": "9.5.0",
    "razorpay": "2.9.8"
  },
  "devDependencies": {
    "@parkease/config": "workspace:*",
    "@parkease/testing": "workspace:*",
    "tsx": "4.19.2",
    "vitest": "2.1.8"
  }
}

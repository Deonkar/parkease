# React Native's Metro bundler resolves modules by walking real directories.
# pnpm's default symlinked store breaks that walk, so the mobile app cannot
# resolve its own dependencies. Hoisted linking is a hard requirement, not a
# preference. See ADR-020.
node-linker=hoisted

# Exact versions only. rules.md forbids ^ and ~ outside Expo's managed set.
save-exact=true

# Fail loudly if the local Node does not match engines.node.
engine-strict=true

link-workspace-packages=deep

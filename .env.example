# R-ENV-01: every variable documented, with an obviously fake example value.
# R-ENV-06 / ADR-022: two local databases. The agent uses parkease_test only.

# parkease_dev  -> the developer's database (.env.development)
# parkease_test -> the coding agent's database (.env.test)
DATABASE_URL=postgresql://parkease:parkease_local@localhost:5432/parkease_test

REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Firebase Auth — backend verifies the client-issued ID token (ADR: no server-side verifyOtp)
FIREBASE_PROJECT_ID=parkease-fake-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fake@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFAKE\n-----END PRIVATE KEY-----\n"

# Razorpay Route (splits) + RazorpayX (payouts) — ADR-013
RAZORPAY_KEY_ID=rzp_test_fake0000000000
RAZORPAY_KEY_SECRET=fakesecretfakesecret00
RAZORPAY_WEBHOOK_SECRET=fake_webhook_secret_000

# Maps
GOOGLE_MAPS_API_KEY=AIzaFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE

# Client-visible (R-ENV-05: shipped to users — nothing sensitive behind these prefixes)
EXPO_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
